# ============================================================
# ARCHON CG-223 — Environment Configuration
# ============================================================
# Copy this file to `.env` and fill in the values.
#
#   cp .env.example .env
#
# Only the REQUIRED section is needed to boot. Everything else
# enables optional features — leave blank to keep them off.
#
# Most *_CHANNEL_ID and *_ROLE_ID values can be set per-server
# from the dashboard or `/serversettings` instead of here. The
# .env values act as global defaults.
#
# To copy a Discord ID: enable Developer Mode
# (User Settings > Advanced), then right-click > Copy ID.
# ============================================================


# ------------------------------------------------------------
# REQUIRED — the bot will not start without these
# ------------------------------------------------------------

# Bot token from https://discord.com/developers/applications
# > your app > Bot > Reset Token
DISCORD_TOKEN=

# Application ID of the same app (Bot > General Information)
# Used to register slash commands.
CLIENT_ID=

# Your own Discord user ID. Grants owner-only commands
# (reboot, broadcast, admin diagnostics).
OWNER_ID=


# ------------------------------------------------------------
# CORE SETTINGS — sensible defaults, change if you need to
# ------------------------------------------------------------

# Prefix for text commands. Slash commands are unaffected.
PREFIX=.

# SQLite database file. Relative paths resolve from the bot root.
# The file is created automatically on first boot.
DB_PATH=./data/database.sqlite

# production | development
NODE_ENV=production

# Set to true for ONE boot to re-register slash commands with
# Discord, then set back to false. Needed after adding, removing
# or renaming a command.
REFRESH_SLASH_COMMANDS=false

# Your home/support server ID. Guild commands register instantly
# there; global registration can take up to an hour.
GUILD_ID=


# ------------------------------------------------------------
# HOME SERVER CHANNELS — optional
# ------------------------------------------------------------
# Global fallbacks used when a server has not configured its own
# via the dashboard or `/serversettings`. Safe to leave blank.

WELCOME_CHANNEL_ID=
GOODBYE_CHANNEL_ID=
GENERAL_CHANNEL_ID=
RULES_CHANNEL_ID=
LOG_CHANNEL_ID=
MOD_LOG_CHANNEL_ID=
SHOP_CHANNEL_ID=
GIFT_CHANNEL_ID=
DAILY_CHANNEL_ID=


# ------------------------------------------------------------
# HOME SERVER ROLES — optional
# ------------------------------------------------------------

# Auto-assigned to new members on join.
AUTO_ROLE_ID=
MEMBER_ROLE=

# Applied by the mute command. Must deny Send Messages.
MUTE_ROLE_ID=

# Awarded automatically at daily-streak milestones.
DAILY_INITIATE_ROLE_ID=
DAILY_WARRIOR_ROLE_ID=
DAILY_CHAMPION_ROLE_ID=
DAILY_LEGEND_ROLE_ID=

# Awarded through activity in their respective features.
GAMER_ROLE_ID=
DUELIST_ROLE_ID=
INVESTOR_ROLE_ID=
QUIZ_MASTER_ROLE_ID=


# ------------------------------------------------------------
# TICKET SYSTEM — optional
# ------------------------------------------------------------

# Category new ticket channels are created under.
TICKET_CATEGORY_ID=

# Role pinged on new tickets; sees every ticket channel.
TICKET_STAFF_ROLE_ID=

# Closed-ticket transcripts are posted here.
TICKET_TRANSCRIPT_CHANNEL_ID=

# Open tickets per user before new ones are refused.
TICKET_LIMIT_PER_USER=3

# Hours of inactivity before a ticket auto-closes. 0 disables.
TICKET_AUTO_CLOSE_HOURS=48


# ------------------------------------------------------------
# AI — optional (powers Lydia)
# ------------------------------------------------------------
# Lydia stays offline unless at least one of these is set.

# https://openrouter.ai/keys — widest model selection.
OPENROUTER_API_KEY=

# https://console.groq.com/keys — fast, generous free tier.
GROQ_API_KEY=


# ------------------------------------------------------------
# MUSIC — optional
# ------------------------------------------------------------

# Fetched automatically at boot; only set this to pin a
# specific client ID.
SOUNDCLOUD_CLIENT_ID=

# https://developer.spotify.com/dashboard
# Resolves Spotify links to playable tracks. Both or neither.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=


# ------------------------------------------------------------
# UTILITY APIS — optional
# ------------------------------------------------------------
# Each one only affects its own command.

# weather   — https://www.weatherapi.com
WEATHER_API_KEY=

# web search for Lydia — https://brave.com/search/api
BRAVE_API_KEY=

# image commands — https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=

# youtube search — https://console.cloud.google.com (YouTube Data API v3)
YOUTUBE_API_KEY=


# ------------------------------------------------------------
# TELEGRAM BRIDGE — optional
# ------------------------------------------------------------

# Token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Chat or channel that receives bridged messages and alerts.
TELEGRAM_CHAT_ID=


# ------------------------------------------------------------
# TOP.GG — optional
# ------------------------------------------------------------
# Only relevant if your bot is listed on top.gg.

# Verifies votes on claim. Top.gg > your bot > Webhooks > API token.
TOPGG_API_TOKEN=

# Shared secret for instant vote notifications. Must match the
# value set in your top.gg webhook settings.
TOPGG_WEBHOOK_SECRET=


# ------------------------------------------------------------
# DASHBOARD & WEB API — optional
# ------------------------------------------------------------
# Only needed if you run the React dashboard.

# HTTP port for the bot's API server.
PORT=5000

# From Discord Developer Portal > OAuth2. Add REDIRECT_URI to the
# app's redirect list or login will fail.
DISCORD_CLIENT_SECRET=
REDIRECT_URI=http://localhost:5000/oauth/callback

# Where the dashboard and API live. Update both for production.
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Comma-separated origins allowed to call the API.
API_CORS_ORIGINS=http://localhost:5173

# Signs dashboard login sessions. Use a long random string:
#   openssl rand -hex 32
JWT_SECRET=

# Protects admin-only API routes. Generate the same way.
API_ADMIN_SECRET=

# Max request body size for API routes.
MAX_PAYLOAD_SIZE=1mb


# ------------------------------------------------------------
# PREMIUM / PAYMENTS — optional
# ------------------------------------------------------------
# Dodo Payments subscriptions. Skip unless you sell premium.

DODO_API_KEY=
DODO_PRODUCT_ID=
DODO_PRODUCT_ID_YEARLY=

# Verifies incoming Dodo webhook signatures.
DODO_WEBHOOK_SECRET=


# ------------------------------------------------------------
# DEPLOY WEBHOOK — optional
# ------------------------------------------------------------
# Auto-pull and restart on git push. Skip for panel hosting.

WEBHOOK_PORT=9000

# Must match the secret configured in your GitHub webhook.
WEBHOOK_SECRET=

# Requests allowed per window, and the window in milliseconds.
WEBHOOK_RATE_LIMIT=10
WEBHOOK_RATE_WINDOW=60000

# Seconds a delivery ID is remembered, so GitHub retries are
# not processed twice.
DEDUP_TTL_SECONDS=300

# GitHub App credentials for automated commits. Only needed if
# something pushes to the repo on your behalf.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=


# ------------------------------------------------------------
# MONITORING — optional
# ------------------------------------------------------------

# Heap thresholds in MB. The guardian logs a warning at WARN,
# writes a snapshot at SNAP, and restarts at CRITICAL.
HEAP_WARN_MB=400
HEAP_SNAP_MB=500
HEAP_CRITICAL_MB=700

# Pinged periodically to keep free hosts from sleeping.
# Leave blank on a VPS.
KEEPALIVE_URL=

# Receives periodic bot statistics. Leave blank to disable.
STATS_SYNC_URL=

